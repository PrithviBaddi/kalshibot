# Copy to `.env.local` for local Next.js dev. Do not commit real secrets.

NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional: same value as backend KALSHIBOT_API_TOKEN (required when the server sets that var).
# NEXT_PUBLIC_API_TOKEN=

# Stage 12: set to 1 when backend has KALSHIBOT_USER_AUTH=1 (login/register + JWT instead of shared token).
# NEXT_PUBLIC_USER_AUTH=1
