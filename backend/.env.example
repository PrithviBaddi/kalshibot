# Copy to `backend/.env` and fill in. Do not commit real secrets.

# --- Legacy single-tenant (default): Kalshi on the server ---
# Kalshi Trade API (RSA): https://kalshi.com → Account → API Keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- Stage 12 multi-tenant SaaS (optional) ---
# When set, Kalshi keys come from each user (encrypted in SQLite), not from env above.
# KALSHIBOT_USER_AUTH=1
# JWT_SECRET=generate-a-long-random-string
# Server-only Fernet key to encrypt per-user Kalshi keys in SQLite (NOT your Kalshi API key — generate once):
# KALSHIBOT_CREDENTIALS_ENCRYPTION_KEY=
#   Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Paste the one line (44 chars, url-safe base64) as the value, no quotes.

# Optional: require Authorization: Bearer <token> on all API routes (except /health, /api/v1/status, docs).
# With USER_AUTH, users send JWT; you can still set this for admin/script access as user id 1.
# KALSHIBOT_API_TOKEN=

# Stripe (Stage 12 billing) — optional
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# PUBLIC_APP_URL=https://app.yourdomain.com  # used for checkout/portal return URLs; set in production

# Free tier (multi-tenant): max successful market analyses per user per UTC day (default 25)
# FREE_TIER_ANALYSIS_PER_DAY=25
# FREE_TIER_NEWS=1  # 0 = skip news on free tier; 1 = allow (uses NEWS_API_KEY if set)
# FREE_TIER_SCANNER_PER_DAY=40   # GET /api/v1/scanner/opportunities (per UTC day)
# FREE_TIER_JOB_RUNS_PER_DAY=30  # manual POST .../run-once and run-all-enabled-once

# Password reset emails (optional — without these, reset links may be logged server-side only)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# Daily pick job (POST /api/v1/daily-picks/generate with KALSHIBOT_API_TOKEN) uses server Kalshi env keys
# even when KALSHIBOT_USER_AUTH=1 — set KALSHI_API_KEY_ID + PEM below for that job.
# With ANTHROPIC_API_KEY (+ optional NEWS_API_KEY), the job uses a reader-friendly Claude prompt; otherwise baseline-only.
# Default: weekday rotation across Kalshi categories (UTC): Mon/Thu Politics, Tue/Fri Economics, Wed/Sat Financials,
# Sun picks the highest pool-quality score among Politics, Economics, and Financials.
# Set DAILY_PICK_CATEGORY to force one category and skip rotation (e.g. Politics).
# DAILY_PICK_CATEGORY=Politics
# DAILY_PICK_MAX_SERIES=10
# DAILY_PICK_MARKETS_PER_SERIES=40
# DAILY_PICK_MIN_VOLUME=400
# DAILY_PICK_MAX_SPREAD=0.42
# Pick one market from the filtered pool: random (default, same pick for all users per UTC day) or top (highest score).
# DAILY_PICK_SELECTION=random
# Optional salt so you can rotate the daily random draw without changing code (default: kalshibot).
# DAILY_PICK_SEED_SALT=kalshibot

# Claude analysis: https://console.anthropic.com
ANTHROPIC_API_KEY=

# News headlines for analysis: https://newsapi.org
NEWS_API_KEY=

# Optional — defaults: Haiku 4.5 for in-app analysis; Sonnet 4.6 for daily pick (override with ANTHROPIC_MODEL_DAILY_PICK).
# See https://platform.claude.com/docs/en/about-claude/models/overview
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL_DAILY_PICK=claude-sonnet-4-6
# Strongest (higher cost/latency): claude-opus-4-7
# JWT_EXPIRES_SECONDS=604800
